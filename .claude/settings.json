{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && (python3 scripts/sync_transcripts.py 2>/dev/null || python scripts/sync_transcripts.py)",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
